{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:face-trajectory:activity-config:0.13.0",
  "description":"Local example structure checks only. Placeholder identities, cameras, photos, weights and clock authority still need authoritative setup.",
  "$defs":{
    "activity_context":{
      "type":"object",
      "required":["activity_id","activity_num","config_version","binding_version","monitoring_version"],
      "properties":{
        "activity_id":{"type":"string","minLength":1},
        "activity_num":{"type":"string","minLength":1},
        "config_version":{"type":"integer","minimum":0},
        "binding_version":{"type":"integer","minimum":0},
        "monitoring_version":{"type":"integer","minimum":0},
        "route_rule_id":{"type":"string","minLength":1}
      }
    },
    "runtime":{
      "type":"object",
      "required":["schema_version","model_config","state_file","endpoint","p2_authorization_env","cameras_file","http","scheduling","storage"],
      "properties":{
        "schema_version":{"const":1},
        "model_config":{"type":"string","minLength":1},
        "state_file":{"type":"string","minLength":1},
        "endpoint":{"type":"string","pattern":"^https?://"},
        "p2_authorization_env":{"type":"string","minLength":1},
        "cameras_file":{"type":"string","minLength":1},
        "http":{"type":"object","required":["host","port","token_env"],"properties":{"host":{"type":"string","minLength":1},"port":{"type":"integer","minimum":1,"maximum":65535},"token_env":{"type":"string","minLength":1}}},
        "scheduling":{"type":"object","required":["weights","fps"],"properties":{"weights":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"integer","minimum":1}},"fps":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"number","exclusiveMinimum":0}}}},
        "storage":{"type":"object","required":["max_pending","max_database_mb"],"properties":{"max_pending":{"type":"integer","minimum":1},"max_database_mb":{"type":"integer","minimum":1}}}
      }
    },
    "cameras":{
      "type":"object",
      "required":["schema_version","cameras"],
      "properties":{
        "schema_version":{"const":1},
        "cameras":{"type":"array","items":{"type":"object","required":["camera_id","source_id","activity_context"],"properties":{"camera_id":{"type":"string","minLength":1},"source_id":{"type":"string","minLength":1},"activity_context":{"allOf":[{"$ref":"#/$defs/activity_context"},{"required":["route_rule_id"]}]}}}}
      }
    },
    "persons":{
      "type":"object",
      "required":["persons"],
      "properties":{
        "persons":{"type":"array","items":{"allOf":[{"$ref":"#/$defs/activity_context"},{"type":"object","required":["source_id","event_id","person_id","category","revision","expected_revision","evidence_id","photos"],"properties":{"source_id":{"type":"string","minLength":1},"event_id":{"type":"string","minLength":1},"person_id":{"type":"string","minLength":1},"category":{"enum":["PRIORITY","NORMAL"]},"revision":{"type":"integer","minimum":1},"expected_revision":{"type":"integer","minimum":0},"evidence_id":{"type":"string","minLength":1},"photos":{"type":"array","minItems":1,"maxItems":64,"items":{"type":"string","minLength":1}}}}]}}
      }
    }
  }
}
